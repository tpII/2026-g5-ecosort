# Copiar a .env (gitignored: es la config de ESTE despliegue, no del repo) y ajustar.
# Docker Compose lo lee solo si existe en esta carpeta — no hace falta exportar nada a mano.
# Ver host/README.md, sección "Configuración".

# IP de la Pi en la red (192.168.20.1 es el diseño con Access Point; hoy, mientras eso no esté
# implementado, es la IP que tenga en la red que están usando para probar — ver
# docs/guia-instalacion-raspberry.md).
ECOSORT_BROKER=192.168.20.1

# De dónde sirve el video ecosort_pi.py --video (la Pi, no este host). Vacío si no lo usan.
ECOSORT_VIDEO=http://192.168.20.1:8000/stream

# Puerto del dashboard en ESTE host (no en la Pi)
DASHBOARD_PORT=8080

# Solo para docker-compose.dev.yml (el broker local, sin Pi)
MQTT_PORT=1883
